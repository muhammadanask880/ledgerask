# OpenAI API key used for the chat/tool-calling agent. Get one at platform.openai.com
OPENAI_API_KEY=sk-your-key-here

# Cheap, fast model by default to keep demo costs near zero. Override with any model
# your account has access to.
OPENAI_MODEL=gpt-5-nano

# Long random string used to sign login session tokens (JWT). Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Name of the cookie that stores the signed session token.
SESSION_COOKIE_NAME=ledgerask_session

# SQLite file holding the read-only business data (customers/orders/products/...).
BUSINESS_DB_PATH=data/ledgerask_business.db

# SQLite file holding app data: user accounts and chat history. Never queried by the AI.
APP_DB_PATH=data/ledgerask_app.db

# Where every question + the exact SQL it ran gets logged for audit purposes.
QUERY_LOG_PATH=logs/queries.log
